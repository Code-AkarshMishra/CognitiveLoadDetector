{
    "manifest_version": 3,
    "name": "NeuroTrack Activity Collector",
    "version": "1.0.0",
    "description": "Collects real-time browser keyboard and mouse activity for NeuroTrack.",
    "permissions": [
        "activeTab",
        "storage",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "NeuroTrack Activity Collector"
    }
}